# =========================================================
# CIVICSOL - Environment Variables Configuration Template
# NOTE: Use placeholders only. Never commit real credentials.
# =========================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=civicsol_user
DB_PASSWORD=your_secure_db_password
DB_NAME=civicsol_db
DATABASE_URL=postgresql://civicsol_user:your_secure_db_password@localhost:5432/civicsol_db

# JWT Security
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_hex_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis Cache & Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload Policies
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10

# Initial Super Admin Bootstrap (Interactive CLI or secure env vars)
BOOTSTRAP_SUPERADMIN_EMAIL=admin@civicsol.gov
BOOTSTRAP_SUPERADMIN_NAME=Municipal Chief Administrator
BOOTSTRAP_SUPERADMIN_EMPLOYEE_ID=SA-00001
# BOOTSTRAP_SUPERADMIN_PASSWORD=  (Optional: if omitted, getpass prompts securely)
