# =========================================================
# CIVICSOL - Production Environment Configuration Template
# Duplicate this file to .env.production and provide production credentials.
# Never commit real passwords or API keys to version control.
# =========================================================

# --- Application Core ---
APP_NAME=CIVICSOL
APP_VERSION=1.0.0
DEBUG=False

# --- Database (PostgreSQL 15+) ---
POSTGRES_DB=civicsol
POSTGRES_USER=civicsol_user
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE
DATABASE_URL=postgresql://civicsol_user:YOUR_STRONG_POSTGRES_PASSWORD_HERE@postgres:5432/civicsol

# --- Redis Cache & Rate Limiting ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Authentication & JWT Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET=GENERATE_STRONG_RANDOM_SECRET_HEX_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google Gemini Civic Intelligence API ---
GEMINI_API_KEY=YOUR_SECURE_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash

# --- YOLO Computer Vision Model ---
YOLO_MODEL_PATH=ml/training/weights/best.pt
YOLO_CONF_THRESHOLD=0.25

# --- Storage & Uploads ---
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10

# --- Network & CORS ---
# Comma-separated list of allowed origins (e.g., https://civicsol.gov.in)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# --- Frontend Build Parameters ---
VITE_API_URL=http://localhost:8000

# --- Municipal Email / SMTP Dispatch (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=585
SMTP_USERNAME=alerts@civicsol.gov.in
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
SMTP_FROM_NAME="CIVICSOL Municipal Authority"
SMTP_FROM_EMAIL=alerts@civicsol.gov.in

