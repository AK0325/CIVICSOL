# =========================================================
# CIVICSOL - Production Backend Dockerfile
# Multi-stage optimized Python 3.11 runtime with OpenCV/PyTorch support
# =========================================================

FROM python:3.11-slim as base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install minimal OS dependencies for OpenCV, PyTorch, and PostgreSQL connectivity
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code and ML assets
COPY backend /app/backend
COPY ml /app/ml
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini

# Create uploads directory structure
RUN mkdir -p /app/uploads/annotated && \
    chmod -R 775 /app/uploads

EXPOSE 8000

# Health check using active backend health endpoint
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/health || exit 1

# Production WSGI/ASGI entrypoint
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]

